{
  "name": "@local/dsh-taskbar-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Taskbar attention and silent Windows notifications for finished DSH Desktop conversations.",
  "engines": { "dsh": "0.2.2-rc.5" },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "windows", "taskbar", "notifications"],
  "files": ["index.js", "completion.js", "windows.js", "flash.ps1", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "check.mjs"],
  "scripts": { "test": "node check.mjs" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml", "platforms": ["win32"] } }
}
