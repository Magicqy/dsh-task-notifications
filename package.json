{
  "name": "dsh-task-notifications",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Background task notifications for DeepSeek Harness Desktop (Windows).",
  "engines": { "dsh": "0.2.2-rc.5" },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "windows", "taskbar", "notifications"],
  "repository": { "type": "git", "url": "git+https://github.com/Magicqy/dsh-task-notifications.git" },
  "homepage": "https://github.com/Magicqy/dsh-task-notifications#readme",
  "bugs": { "url": "https://github.com/Magicqy/dsh-task-notifications/issues" },
  "license": "MIT",
  "files": ["index.js", "completion.js", "titles.js", "windows.js", "flash.ps1", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "check.mjs", "check-windows.mjs", "check-preferences.mjs"],
  "scripts": { "test": "node check.mjs && node check-windows.mjs && node check-preferences.mjs" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml", "platforms": ["win32"] } }
}
